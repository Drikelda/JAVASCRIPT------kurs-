
<!DOCTYPE html>
<html>
<head>
    <title>Resizable Box</title>

    <!-- jQuery CDN -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- jQuery UI CDN -->
    <script src="https://code.jquery.com/ui/1.14.1/jquery-ui.min.js"></script>

    <!-- jQuery UI CSS -->
    <link rel="stylesheet"
          href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css">

    <style>
        #resizable {
            width: 200px;
            height: 150px;
            background-color: lightblue;
            border: 2px solid blue;
            text-align: center;
            display: flex;
            justify-content: center;
            align-items: center;
            margin: 30px;
        }
    </style>
</head>

<body>

    <h2>jQuery UI Resizable Example</h2>

    <p>Drag the borders or corners to resize the box.</p>

    <div id="resizable">
        Resize Me!
    </div>

    <script>
        $(document).ready(function() {

            // Enable resizing
            $("#resizable").resizable();

        });
    </script>

</body>
</html>
